  "defaultInputModes": ["text"],
  "defaultOutputModes": ["text"],
  "authentication": {
    "schemes": ["x402"]
  },
  "payment": {
    "protocol": "x402",
    "version": "v2",
    "network": "eip155:8453",
    "asset": "USDC",
    "payTo": "0x6A6f526d8686D0c9edEfc65252e720bFa5eA5708",
    "priceRangeUsd": "0.01-0.35"
  },
