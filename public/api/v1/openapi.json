    "/api/v1/agents/me/transactions": {
      "get": {
        "summary": "Agent Spending Receipts & Itemized Transaction History",
        "description": "Retrieves an itemized, machine-readable ledger of transactions for the authenticated agent.",
        "operationId": "getAgentTransactions",
        "security": [],
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 25, "maximum": 100 }, "description": "Maximum number of transactions to return." },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Opaque pagination cursor token." },
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string", "enum": ["DEBIT", "CREDIT"] }, "description": "Filter by transaction type." },
          { "name": "tag", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Filter by metadata tag (e.g. METERED_API)." },
          { "name": "since", "in": "query", "required": false, "schema": { "type": "string" }, "description": "ISO-8601 timestamp filter." }
        ],
        "responses": {
          "200": {
            "description": "Itemized list of transactions with running balances and pagination metadata.",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "agentId": "agent_auto_a1b2c3d4e5",
                  "entries": [],
                  "pagination": { "limit": 25, "nextCursor": null, "hasMore": false }
                }
              }
            }
          }
        }
      }
    },
    "/api/data/market": {
      "get": {
        "summary": "Real-Time Market Data Feed (x402: $0.01 USDC)",
        "description": "Verified real-time stock prices, 24h percentage changes, volume, and Super Sonic Tsunami watchlist metrics. Supports single symbol lookups (?symbol=...) across US (NYSE, NASDAQ), Hong Kong (.HK), and India (NSE .NS, BSE .BO). Unsupported symbols return 404. Settled via x402 USDC micropayment ($0.01 USDC).",
        "operationId": "getMarketData",
        "parameters": [
          { "name": "symbol", "in": "query", "required": false, "schema": { "type": "string" }, "example": "NVDA" }
        ],
        "x-payment-info": {
          "price": { "mode": "fixed", "currency": "USD", "amount": "0.010000" },
          "protocols": [{
            "x402": {
              "version": 2,
              "scheme": "exact",
              "network": "eip155:8453",
              "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
              "payTo": "0x6A6f526d8686D0c9edEfc65252e720bFa5eA5708",
              "amountAtomic": "10000",
              "decimals": 6
            }
          }]
        },
        "responses": {
          "200": {
            "description": "Market data watchlist payload.",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "feed": "market",
                  "updated_at": "2026-10-08T12:00:00.000Z",
                  "total_assets": 20,
                  "watchlist": [
                    { "symbol": "NVDA", "price": 138.25, "changePercent": 2.45, "volume": "48.2M", "sbScore": 88, "action": "ACCUMULATE" }
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Payment Required. Returns x402 payment requirements in PAYMENT-REQUIRED header.",
            "content": {
              "application/json": {
                "example": {
                  "status": "error",
                  "code": "PAYMENT_REQUIRED",
                  "error": "Payment required",
                  "message": "x402 payment required"
                }
              }
            }
          },
          "404": {
            "description": "Unsupported or invalid symbol."
          }
        }
      }
    },
