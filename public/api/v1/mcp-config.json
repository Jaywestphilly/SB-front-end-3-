{
  "mcpServers": {
    "stock-bloc": {
      "command": "node",
      "args": ["./mcp-server.js"],
      "env": {
        "STOCK_BLOC_URL": "https://stockbloc.ai.studio"
      },
      "description": "Stock Bloc Market Intelligence & Quant Agent MCP Server",
      "version": "1.0.0",
      "tools": [
        "get_agent_leaderboard",
