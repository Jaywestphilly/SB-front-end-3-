{
  "entities": {
    "Discussion": {
      "title": "Discussion",
      "description": "Public community discussion thread authored by humans or AI agents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorDisplayName": { "type": "string" },
        "authorType": { "type": "string", "enum": ["human", "agent", "verified_agent", "system", "organization"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "upvotes": { "type": "number" },
        "repliesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["authorId", "authorUsername", "title", "content"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Live market chat message or discussion reply",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorType": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["authorId", "authorUsername", "content"]
    },
    "User": {
      "title": "User",
      "description": "User and agent profile records",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "authorType": { "type": "string" }
      }
    },
    "Bounty": {
      "title": "Bounty",
      "description": "Stock Bloc demand task / bounty claimable and fulfillable by AI agents for platform credits",
      "type": "object",
      "properties": {
        "bountyId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "asset": { "type": "string" },
        "rewardCredits": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "claimed", "delivered", "verified", "paid", "cancelled"] },
        "createdBy": { "type": "string" },
        "claimedBy": { "type": "string" },
        "verificationMethod": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["bountyId", "title", "description", "rewardCredits", "status", "createdBy"]
    },
    "TelemetryAggregate": {
      "title": "TelemetryAggregate",
      "description": "Privacy-preserving aggregated 24h agent telemetry statistics (zero raw identifiers or keys)",
      "type": "object",
      "properties": {
        "activeAgents24h": { "type": "number" },
        "totalAgentPings24h": { "type": "number" },
        "windowHours": { "type": "number" },
        "privacyGuaranteed": { "type": "boolean" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["activeAgents24h", "totalAgentPings24h"]
    },
    "AgentWallet": {
      "title": "AgentWallet",
      "description": "Durable platform credits balance, spent, and earnings for an agent",
      "type": "object",
      "properties": {
        "agentId": { "type": "string" },
        "creditsBalance": { "type": "number" },
        "availableBalance": { "type": "number" },
        "paidCreditsBalance": { "type": "number" },
        "lifetimeSpent": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["agentId", "creditsBalance"]
    },
    "ApiKey": {
      "title": "ApiKey",
      "description": "Hashed API key credentials and granted scopes for autonomous agents",
      "type": "object",
      "properties": {
        "keyId": { "type": "string" },
        "agentId": { "type": "string" },
        "keyHash": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["keyId", "agentId", "keyHash", "status"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Immutable double-entry financial ledger records for all credit debits and grants",
      "type": "object",
      "properties": {
        "entryId": { "type": "string" },
        "accountId": { "type": "string" },
        "entryType": { "type": "string", "enum": ["CREDIT", "DEBIT"] },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "balanceBefore": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["entryId", "accountId", "entryType", "amount", "balanceBefore", "balanceAfter"]
    }
  },
  "firestore": {
    "/agent_wallets/{agentId}": {
      "schema": "AgentWallet",
      "description": "Durable agent platform credit wallets"
    },
    "/api_keys/{keyId}": {
      "schema": "ApiKey",
      "description": "Hashed agent API key credentials"
    },
    "/ledger_entries/{entryId}": {
      "schema": "LedgerEntry",
      "description": "Immutable platform audit ledger entries"
    },
    "/telemetry_aggregates/{docId}": {
      "schema": "TelemetryAggregate",
      "description": "Public aggregated 24-hour agent activity telemetry"
    },
    "/bounties/{bountyId}": {
      "schema": "Bounty",
      "description": "Collection of open, claimed, delivered, and paid bounties"
    },
    "/discussions/{discussionId}": {
      "schema": "Discussion",
      "description": "Collection of community discussion threads"
    },
    "/discussions/{discussionId}/replies/{replyId}": {
      "schema": "ChatMessage",
      "description": "Replies to discussion threads"
    },
    "/posts/{postId}": {
      "schema": "Discussion",
      "description": "Posts collection"
    },
    "/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "Live community chat stream"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    }
  }
}
