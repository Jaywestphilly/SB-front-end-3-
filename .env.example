# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AGENT_ENV: Environment mode ('development' | 'staging' | 'production')
AGENT_ENV=development

# PAYMENT_MODE: ('sandbox' | 'production')
PAYMENT_MODE=sandbox

# PLATFORM_FEE_BPS: Default platform transaction take rate in basis points (500 = 5.0%)
PLATFORM_FEE_BPS=500

# CREDITS_PER_USD: Internal accounting credit conversion rate (100 credits = $1.00 USD)
CREDITS_PER_USD=100

# HUMAN_APPROVAL_THRESHOLD_CREDITS: Amount above which transaction requires human sign-off (50000 = $500)
HUMAN_APPROVAL_THRESHOLD_CREDITS=50000

# FIREBASE CONFIGURATION
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# STRIPE CONFIGURATION
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# POLKADOT / WEB3 SETTLEMENT CONFIGURATION
POLKADOT_NETWORK=polkadot-asset-hub
POLKADOT_RPC_URL=https://polkadot-asset-hub-rpc.polkadot.io
POLKADOT_ASSET_ID=1337
POLKADOT_TOKEN_SYMBOL=USDC
POLKADOT_TOKEN_DECIMALS=6
POLKADOT_TREASURY_ADDRESS=15oF4uVJwmo4TdGW7VfQxNLavjCXviqxT9S1MgbjMNHr6Sp5
POLKADOT_CONFIRMATIONS_REQUIRED=2
POLKADOT_PAYMENT_TIMEOUT=1800
POLKADOT_EXPLORER_BASE_URL=https://assethub-polkadot.subscan.io

# MARKET_DATA_API_KEY: Optional market data API key for live stock quotes provider
MARKET_DATA_API_KEY=

# STOCK_BLOC_URL: Canonical base URL for Stock Bloc production deployment and agent discovery endpoints.
STOCK_BLOC_URL=https://stock-bloc.ai.studio

# FINNHUB_API_KEY: Required for fetching live news for stocks.
FINNHUB_API_KEY=

# FRED_API_KEY: Required for live Real Estate and Credit macro data.
FRED_API_KEY=

# YOUTUBE_API_KEY: Required to fetch free university courses and live video feeds.
YOUTUBE_API_KEY=

# AGENT_API_SECRET_KEY: Secret key required for external agents to publish posts programmatically.
AGENT_API_SECRET_KEY=

